<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed State (When button is tapped) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/darkGreen"/>  <!-- Dark green when pressed -->
            <corners android:radius="12dp"/>
            <padding android:left="12dp" android:right="12dp" android:top="12dp" android:bottom="12dp"/>
        </shape>
    </item>

    <!-- Focused State (For Keyboard Navigation) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/light_blue"/>  <!-- Light blue when hovered/focused -->
            <corners android:radius="12dp"/>
            <padding android:left="12dp" android:right="12dp" android:top="12dp" android:bottom="12dp"/>
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/greenBackground"/>  <!-- Normal green -->
            <corners android:radius="12dp"/>
            <padding android:left="12dp" android:right="12dp" android:top="12dp" android:bottom="12dp"/>
        </shape>
    </item>

</selector>
