<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed State (When button is tapped) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/greenBackground"/>  <!-- Button turns solid green -->
            <stroke android:width="2dp" android:color="@color/darkGreen"/>  <!-- Darker green border -->
            <corners android:radius="12dp"/>
            <padding android:left="12dp" android:right="12dp" android:top="12dp" android:bottom="12dp"/>
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>  <!-- Transparent background -->
            <stroke android:width="2dp" android:color="@color/greenBackground"/>  <!-- Normal green border -->
            <corners android:radius="12dp"/>
            <padding android:left="12dp" android:right="12dp" android:top="12dp" android:bottom="12dp"/>
        </shape>
    </item>

</selector>
