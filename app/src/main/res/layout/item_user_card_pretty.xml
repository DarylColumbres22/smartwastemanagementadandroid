<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:elevation="2dp"
    app:cardCornerRadius="1dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header: Email + UID -->
        <TextView
            android:id="@+id/tvEmail"
            android:textStyle="bold"
            android:text="godwindarylcolumbers@gmail.com"
            android:textSize="16sp"
            android:textColor="#111827"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvUidLabel"
                android:text="UID:"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvUidValue"
                android:textColor="#6B7280"
                android:text="2394875"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#E5E7EB" />

        <!-- Role row -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ImageView
                android:src="@drawable/ic_profiles_selector"
                android:tint="#6B7280"
                android:layout_width="18dp"
                android:layout_height="18dp" />

            <TextView
                android:text="  Role:"
                android:textColor="#374151"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvRole"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Verified + Status row (2 columns) -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Verified (left) -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:src="@drawable/ic_check"
                    android:tint="#6B7280"
                    android:layout_width="18dp"
                    android:layout_height="18dp" />

                <TextView
                    android:text="  Email Verified:"
                    android:textColor="#374151"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/badgeVerified"
                    android:layout_marginStart="8dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="True"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:background="@drawable/badge_green"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Status (right) -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:src="@drawable/ic_disabled"
                    android:tint="#6B7280"
                    android:layout_width="18dp"
                    android:layout_height="18dp" />

                <TextView
                    android:text="  Status:"
                    android:textColor="#374151"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/badgeStatus"
                    android:layout_marginStart="8dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="Active"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:background="@drawable/badge_gray"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Created + Last sign-in row (2 columns) -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Created -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:src="@drawable/ic_clock"
                    android:tint="#6B7280"
                    android:layout_width="18dp"
                    android:layout_height="18dp" />

                <TextView
                    android:text="  Created:"
                    android:textColor="#374151"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvCreated"
                    android:textColor="#111827"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Last sign-in -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:src="@drawable/ic_logout"
                    android:tint="#6B7280"
                    android:layout_width="18dp"
                    android:layout_height="18dp" />

                <TextView
                    android:text="  Last Sign-In:"
                    android:textColor="#374151"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvLastSignIn"
                    android:textColor="#111827"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E5E7EB" />
        <!-- Actions -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnToggle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Disable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Delete"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/white"
                android:backgroundTint="@android:color/holo_red_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
