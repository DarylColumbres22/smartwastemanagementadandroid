<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/logoLoading"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/smartwatelogo"
            android:contentDescription="@string/cd_app_logo" />

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for login approval…"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Approve this sign-in on your other device to continue."
            android:textSize="14sp"
            android:textColor="#555"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/linkUseEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send the OTP to my email instead"
            android:textSize="14sp"
            android:textColor="#2962FF"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
