<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State (When button is tapped) -->
    <item android:state_pressed="true" android:color="@android:color/white"/>  <!-- White text when pressed -->

    <!-- Focused State (Mouse Hover or Keyboard Focus) -->
    <item android:state_focused="true" android:color="@color/darkGreen"/>  <!-- Dark green text when hovered -->

    <!-- Default State -->
    <item android:color="@android:color/white"/>  <!-- Normal white text -->

</selector>